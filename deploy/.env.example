# Copy to deploy/.env (install.sh generates secrets for you). Never commit the real .env.
DB_PASSWORD=change-me
PARK_SECRET_KEY=change-me-long-random
PARK_ANPR_API_KEY=change-me
PARK_DEVICE_API_KEY=change-me
PARK_RELAY_API_KEY=change-me
PARK_SITE_TIMEZONE=Asia/Kolkata

# Storage (host paths)
PG_DATA_DIR=/srv/parking/pgdata
IMAGE_DIR=/mnt/images/parking
UPLOAD_DIR=/srv/parking/uploads
ANPR_STATE_DIR=/srv/parking/anpr
MODEL_DIR=/srv/parking/models

# Cloud relay (customer pages). Leave PARK_RELAY_URL empty to disable sync.
PARK_RELAY_URL=https://pay.example-parking.in
PARK_PUBLIC_RECEIPT_BASE=https://pay.example-parking.in/r
PARK_PUBLIC_SITE_URL=https://pay.example-parking.in

# Payment gateway: mock | razorpay
PARK_GATEWAY=razorpay
PARK_RAZORPAY_KEY_ID=
PARK_RAZORPAY_KEY_SECRET=
PARK_RAZORPAY_WEBHOOK_SECRET=

# Messaging: SMS noop | msg91 ; WhatsApp noop | meta
PARK_SMS_PROVIDER=msg91
PARK_MSG91_AUTH_KEY=
PARK_MSG91_TEMPLATE_RECEIPT=
PARK_MSG91_TEMPLATE_SETTLEMENT=
PARK_MSG91_TEMPLATE_PASS_REMINDER=
PARK_MSG91_TEMPLATE_OTP=
PARK_WHATSAPP_PROVIDER=noop
PARK_WHATSAPP_TOKEN=
PARK_WHATSAPP_PHONE_NUMBER_ID=

# Backups
BACKUP_DIR=/mnt/backup/parking            # external disk
BACKUP_KEEP_DAYS=30
BACKUP_AGE_RECIPIENT=                     # age public key for the encrypted cloud copy
BACKUP_RCLONE_REMOTE=                     # e.g. b2:parking-backups (rclone config on host)

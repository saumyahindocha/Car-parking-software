# Copy to .env (or pass as container environment). All variables are prefixed RELAY_.
RELAY_DATABASE_URL=postgresql+psycopg://relay:CHANGE_ME@db:5432/relay   # or sqlite:////data/relay.db
RELAY_RELAY_API_KEY=CHANGE_ME_long_random                               # = PARK_RELAY_API_KEY on the edge
RELAY_SECRET_KEY=CHANGE_ME_another_long_random                          # cookies, OTP + rate-limit hashing
RELAY_PUBLIC_BASE_URL=https://pay.example.in
RELAY_SITE_TIMEZONE=Asia/Kolkata
RELAY_TRUST_PROXY_HEADERS=true
RELAY_COOKIE_SECURE=true
RELAY_DEMO_MODE=false

# payments
RELAY_GATEWAY=razorpay
RELAY_RAZORPAY_KEY_ID=rzp_live_xxx
RELAY_RAZORPAY_KEY_SECRET=xxx
RELAY_RAZORPAY_WEBHOOK_SECRET=xxx            # webhook URL: https://pay.example.in/webhooks/razorpay

# OTP SMS (MSG91, DLT-registered template with variable ##otp##)
RELAY_SMS_PROVIDER=msg91
RELAY_MSG91_AUTH_KEY=xxx
RELAY_MSG91_TEMPLATE_OTP=xxx

# optional direct delivery to the edge (e.g. over WireGuard); the pull queue always works without it
RELAY_EDGE_URL=
RELAY_GRIEVANCE_CONTACT=Parking office, Station Road - privacy@example.in - 020-1234 5678
